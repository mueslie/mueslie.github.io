{
  "id": "/",
  "name": "Dapp Builder",
  "short_name": "DappBuilder",
  "description": "A P2P, local-first, low-code app builder platform. Design, share, and collaborate on distributed apps — all without a backend.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": { "client_mode": "focus-existing" },
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#0D0E14",
  "theme_color": "#EA580C",
  "categories": ["productivity", "developer", "utilities"],
  "protocol_handlers": [
    { "protocol": "web+dapp", "url": "/invite?code=%s" }
  ],
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": { "application/vnd.dapp-builder+json": [".dapp"] },
      "icons": [{ "src": "/favicon-196.png", "sizes": "196x196", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "video/*", "audio/*", "application/pdf", "text/*"] }]
    }
  },
  "shortcuts": [
    {
      "name": "New Dapp",
      "short_name": "New",
      "description": "Create a new dapp",
      "url": "/?action=new-dapp",
      "icons": [{ "src": "/favicon-196.png", "sizes": "196x196", "type": "image/png" }]
    },
    {
      "name": "Join invite",
      "short_name": "Join",
      "description": "Join an app or pair with a contact from an invite",
      "url": "/?action=join-invite",
      "icons": [{ "src": "/favicon-196.png", "sizes": "196x196", "type": "image/png" }]
    },
    {
      "name": "People & Sharing",
      "short_name": "People",
      "description": "Contacts, pairing, and shares",
      "url": "/people",
      "icons": [{ "src": "/favicon-196.png", "sizes": "196x196", "type": "image/png" }]
    }
  ],
  "icons": [
    { "src": "/favicon-196.png", "sizes": "196x196", "type": "image/png", "purpose": "any" },
    { "src": "/manifest-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/manifest-icon-192.maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/manifest-icon-512.maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide-app.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "A collaborative to-do list Code App running in Dapp Builder"
    },
    {
      "src": "/screenshot-wide-welcome.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Welcome screen — your identity is generated on your device, no account needed"
    },
    {
      "src": "/screenshot-narrow-app.jpg",
      "sizes": "500x799",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Dapp Builder on a phone"
    }
  ]
}
